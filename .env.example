# Supabase Configuration for echo11Lab
# ===========================================
# Get these values from your Supabase Dashboard:
# https://supabase.com/dashboard/project/hwddfqgxmdhsmjzydywz/settings/api

# Project URL (format: https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Anon Public Key (found in Project Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Key (found in Project Settings → API - use carefully, has admin access)
# Only needed for server-side operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=

# Database Password (found in Project Settings → Database)
# Used for CLI commands like supabase db push
# SUPABASE_DB_PASSWORD=
